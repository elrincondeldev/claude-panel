[Unit]
Description=claude-panel kiosk (cage + Chromium on tty1)
After=systemd-user-sessions.service network-online.target claude-panel-ui.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=panel
# A PAM session gives cage a logind seat, so it can take over the display without root.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/opt/claude-panel/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
